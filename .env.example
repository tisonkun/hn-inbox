# ==============================================================================
# Hacker News Monitor Configuration
# ==============================================================================
# Your Hacker News username (required)
HN_USERNAME=your-hn-username

# Optional comma-separated domains or keywords to watch for external submissions
# Example: example.com,myproject.dev
HN_WATCH_DOMAINS=

# Optional comma-separated score thresholds that trigger a one-time milestone alert
HN_SCORE_MILESTONES=10,30,50,100,200,500

# Optional lookback window (in days) for active stories & comments polling
HN_LOOKBACK_DAYS=14

# ==============================================================================
# ScopeDB Configuration (required)
# ==============================================================================
SCOPEDB_ENDPOINT=https://your-scopedb-endpoint.example.com
SCOPEDB_API_KEY=your-scopedb-api-key
SCOPEDB_DATABASE=scopedb
SCOPEDB_SCHEMA=public

# ==============================================================================
# Security & GitHub OAuth Allowlist (required)
# ==============================================================================
# Required on Vercel to authenticate scheduled POST /api/schedules/poll requests
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-random-secret

# Secret used to sign HttpOnly session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-random-secret

# GitHub OAuth App credentials (callback URL: <APP_BASE_URL>/api/auth/github/callback)
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Comma-separated GitHub usernames permitted to access the Web Inbox (case-insensitive)
GITHUB_ALLOWED_USERS=your-github-username

# Public base URL of your deployed inbox (used for OAuth callback & email links)
# Example: https://hn-inbox.example.com
APP_BASE_URL=

# ==============================================================================
# Notification Channels (enable one or more)
# ==============================================================================
# 1. Resend Email Channel (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=HN Inbox <onboarding@resend.dev>
# Comma-separated recipient email addresses
EMAIL_TO=

# 2. Generic JSON Webhook Channel (optional, for Feishu/Slack/custom bridges)
WEBHOOK_URL=
WEBHOOK_BEARER_TOKEN=
